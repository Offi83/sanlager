/* =========================================================
   Basis
   ========================================================= */

:root {
    --color-bg: #f4f5f6;
    --color-surface: #fff;
    --color-border: #ddd;
    --color-border-light: #eee;
    --color-muted: #666;
    --color-muted-light: #777;
    --color-text: #202124;
    --color-primary: #d71920;
    --color-danger: #b00020;

    --space-1: 6px;
    --space-2: 10px;
    --space-3: 16px;
    --space-4: 20px;
    --space-5: 24px;
    --space-6: 32px;

    --content-padding: var(--space-5);
    --card-padding: var(--space-5);
    --card-gap: var(--space-4);

    --radius: 8px;
    --radius-card: 12px;
}

* {
    box-sizing: border-box;
}

html {
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background: var(--color-bg);
    color: var(--color-text);
}

body {
    margin: 0;
}

a {
    color: inherit;
}

.topbar {
    height: 64px;
    padding: 0 var(--content-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
}

.topbar strong {
    font-size: 18px;
    letter-spacing: .03em;
}

.topbar a {
    color: #333;
    text-decoration: none;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-6) var(--content-padding) 60px;
}


/* =========================================================
   Gemeinsame Layouts
   ========================================================= */

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
}

.page-header h1 {
    margin: 0 0 var(--space-1);
    font-size: 30px;
    line-height: 1.15;
}

.page-header p {
    max-width: 720px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.5;
}

.actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    white-space: nowrap;
}

.card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
}

.card + .card {
    margin-top: var(--card-gap);
}

.card-header {
    padding: 18px var(--card-padding);
    background: #fafafa;
    border-bottom: 1px solid var(--color-border-light);
}

.card-body {
    padding: var(--card-padding);
}

.card-header h2 {
    margin: 0;
    font-size: 18px;
}


/* =========================================================
   Buttons
   ========================================================= */

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--radius);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
}

.button.primary {
    background: var(--color-primary);
    color: #fff;
}

.button.secondary {
    background: #eee;
    color: #222;
}

.button.danger,
.button.button-danger {
    background: var(--color-danger);
    color: #fff;
}

.button.small {
    min-height: 38px;
    padding: 0 14px;
    font-size: 14px;
}


/* =========================================================
   Formulare
   ========================================================= */

input,
select,
textarea {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid #c8c8c8;
    border-radius: var(--radius);
    background: var(--color-surface);
    font: inherit;
    font-size: 16px;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
}

label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
}

label > span,
.form-group label {
    font-weight: 600;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
}

.form-group label {
    font-weight: 600;
}

.form-group small {
    color: var(--color-muted-light);
}

.form-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 18px;
}

.form-group.wide {
    grid-column: 1 / -1;
}

.form {
    padding: var(--content-padding);
}

.form > label {
    margin-top: var(--space-5);
}

.form textarea,
.stock-form textarea {
    resize: vertical;
    min-height: 90px;
}

.form-actions {
    display: flex;
    justify-content: flex-start;
    gap: var(--space-2);
    margin-top: 22px;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-light);
}

.form-actions .button {
    min-width: 150px;
}

.form-help {
    margin: -10px 0 22px;
    color: var(--color-muted-light);
}

.description {
    margin-top: 4px;
    color: var(--color-muted-light);
    font-size: 14px;
}


/* =========================================================
   Suche
   ========================================================= */

.search {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
}

.search input {
    flex: 1;
}


/* =========================================================
   Tabellen
   ========================================================= */

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--color-border-light);
}

th {
    background: #fafafa;
    color: #555;
    font-size: 14px;
}

tbody tr:last-child td {
    border-bottom: 0;
}

.category-row th {
    padding-top: 18px;
    padding-bottom: 8px;
    background: #f7f7f7;
    border-bottom: 2px solid var(--color-border);
    font-weight: 700;
}

.category-row:first-child th {
    padding-top: 8px;
}

.category-filter {
    min-width: 190px;
}


/* =========================================================
   Meldungen / Zustände
   ========================================================= */

.alert {
    margin-bottom: var(--space-4);
    padding: 14px 18px;
    border-radius: var(--radius);
}

.alert.success {
    background: #e7f6ea;
    border: 1px solid #a8d5ae;
}

.alert.error {
    background: #fdeaea;
    border: 1px solid #e0a0a0;
}

.warning {
    display: block;
    margin-top: 4px;
    color: var(--color-danger);
    font-size: 13px;
    font-weight: 600;
}

.warning-alert {
    border-left: 5px solid var(--color-danger);
}

.expired-stock-warning {
    display: block;
    margin-top: 5px;
    color: var(--color-danger);
    font-size: 13px;
    font-weight: 700;
}

.empty {
    padding: 70px 30px;
    text-align: center;
}

.empty-icon {
    margin-bottom: 15px;
    font-size: 48px;
}

.empty h2 {
    margin: 0 0 8px;
}

.empty p {
    margin: 0 0 var(--space-5);
    color: var(--color-muted-light);
}

.small-empty {
    padding: var(--content-padding);
}

.empty-state.compact {
    padding: 28px 22px;
    color: var(--color-muted-light);
    text-align: center;
}


/* =========================================================
   Bestand
   ========================================================= */

.stock-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
}

.stock-total,
.stock-minimum {
    padding: 22px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
}

.stock-total span,
.stock-minimum span {
    display: block;
    margin-bottom: 8px;
    color: var(--color-muted);
}

.stock-total strong,
.stock-minimum strong {
    font-size: 28px;
}

.stock-low {
    color: var(--color-danger);
}

.stock-value {
    font-weight: 700;
}

.location-list {
    padding: 0 22px;
}

.location-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-light);
}

.location-row:last-child {
    border-bottom: 0;
}

.location-row strong {
    font-size: 18px;
}


/* =========================================================
   MHD / Chargen
   ========================================================= */

.expiry-ok {
    color: #287a3d;
    font-weight: 600;
}

.expiry-warning {
    color: #9a6700;
    font-weight: 700;
}

.expiry-expired {
    color: var(--color-danger);
    font-weight: 700;
}


/* =========================================================
   Artikeldetail
   ========================================================= */

.article-detail-page .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: 8px;
    color: var(--color-muted);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
}

.article-detail-page .back-link:hover {
    color: var(--color-primary);
}

.article-detail-page .stock-summary {
    grid-template-columns: minmax(0, 1.5fr) minmax(220px, 1fr);
    gap: 18px;
    margin-bottom: 22px;
}

.article-detail-page .stock-total,
.article-detail-page .stock-minimum {
    position: relative;
    padding: 24px 26px;
}

.article-detail-page .stock-total {
    border-left: 4px solid var(--color-primary);
}

.article-detail-page .stock-total span,
.article-detail-page .stock-minimum span {
    margin-bottom: 9px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.article-detail-page .stock-total strong,
.article-detail-page .stock-minimum strong {
    display: block;
    font-size: 32px;
    line-height: 1.1;
}

.article-detail-page .stock-total .warning {
    margin-top: 10px;
}

.article-detail-page .location-row .stock-value {
    font-size: 17px;
}

.article-detail-page .stock-form {
    padding: 22px;
}

.article-detail-page .stock-form > .form-grid {
    grid-template-columns:
        minmax(150px, 1fr)
        minmax(180px, 1.2fr)
        minmax(120px, .7fr)
        minmax(220px, 1.5fr);
    gap: 16px;
}

.article-detail-page .stock-form label > span {
    color: #444;
    font-size: 14px;
    font-weight: 700;
}

.article-detail-page .stock-form > label {
    margin-top: 18px;
}

.article-detail-page .conditional-field {
    margin-top: 18px;
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fafafa;
}

.article-detail-page .conditional-field .form-help {
    margin: 8px 0 0;
}

.article-detail-page .stock-form .form-actions {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
}

.article-detail-page .stock-form .form-actions .button {
    min-width: 150px;
}


/* =========================================================
   QR-Code
   ========================================================= */

.article-qr-card {
    margin-bottom: var(--space-4);
}

.article-qr-content {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: 22px;
}

.article-qr-code {
    flex: 0 0 180px;
    width: 180px;
    height: 180px;
}

.article-qr-code svg,
.label-qr svg {
    display: block;
    width: 100%;
    height: 100%;
}

.article-qr-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
}

.article-qr-info strong {
    font-size: 18px;
}

.article-qr-info span {
    color: #555;
}

.article-qr-info small {
    margin-top: 8px;
    color: var(--color-muted-light);
}


/* =========================================================
   Ausbuchen / Scanner
   ========================================================= */

.issue-card {
    padding: var(--content-padding);
}

.issue-form {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
}

.issue-form label {
    flex: 1;
}

.issue-form label > span {
    color: #444;
    font-size: 14px;
    font-weight: 700;
}

.issue-form input {
    min-height: 52px;
    font-size: 20px;
}

.issue-form .button {
    min-width: 160px;
    min-height: 52px;
}

.issue-scan-button {
    margin-bottom: var(--space-3);
}

.issue-scanner {
    width: 100%;
    max-width: 420px;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-card);
}

.issue-scanner video {
    display: block;
    width: 100%;
}

.issue-scan-status {
    margin-bottom: var(--space-3);
    padding: var(--space-2) 12px;
    border-radius: var(--radius);
    background: #f1f3f4;
    color: #444;
}

.scan-result {
    margin-top: var(--space-3);
    padding: 14px 16px;
    border-radius: var(--radius);
    background: #eaf6ea;
    font-weight: 600;
}

.scan-result.error {
    background: #fbeaea;
}

.today-summary {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 22px;
}

.today-summary strong {
    font-size: 32px;
}

.today-summary span {
    color: var(--color-muted);
}


/* =========================================================
   Etikettendruck
   ========================================================= */

.label-print-page {
    width: 210mm;
    height: 296mm;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 105mm);
    grid-template-rows: repeat(4, 74mm);
}

.label {
    width: 105mm;
    height: 74mm;
    padding: 7mm;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 0.3mm solid #888;
    background: #fff;
}

.label-category {
    margin-bottom: 4mm;
    color: #555;
    font-size: 11pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.label-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6mm;
}

.label-text {
    min-width: 0;
    flex: 1;
}

.label-name {
    font-size: 18pt;
    font-weight: 700;
    line-height: 1.15;
    overflow-wrap: anywhere;
}

.label-number {
    margin-top: 5mm;
    color: #555;
    font-size: 11pt;
    font-family: monospace;
}

.label-qr {
    flex: 0 0 35mm;
    width: 35mm;
    height: 35mm;
}

@media screen {
    .label-print-page {
        margin-top: var(--space-4);
        box-shadow: 0 0 0 1px var(--color-border);
    }
}

@media print {
    @page {
        size: A4 portrait;
        margin: 0;
    }

    html,
    body {
        width: 210mm;
        margin: 0;
        padding: 0;
        background: #fff;
    }

    .topbar,
    .container > *:not(.label-print-page) {
        display: none !important;
    }

    .container {
        width: 210mm;
        max-width: none;
        margin: 0;
        padding: 0;
    }

    .label-print-page {
        width: 210mm;
        height: 296mm;
        margin: 0;
    }

    .label {
        break-inside: avoid;
        page-break-inside: avoid;
    }
}


/* =========================================================
   Responsive
   ========================================================= */

@media (min-width: 701px) {
    .article-detail-page .stock-form input,
    .article-detail-page .stock-form select,
    .form input,
    .form select {
        min-height: 48px;
    }
}

@media (max-width: 900px) {
    .article-detail-page .stock-summary {
        grid-template-columns: 1fr;
    }

    .article-detail-page .stock-form > .form-grid {
        grid-template-columns: 1fr 1fr;
    }

    .form-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 700px) {
    .container {
        padding: 20px 14px 40px;
    }

    .page-header {
        align-items: stretch;
        flex-direction: column;
    }

    .page-header .button,
    .actions .button {
        width: 100%;
    }

    .actions {
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-1);
    }

    .search {
        flex-wrap: wrap;
    }

    .search input {
        flex-basis: 100%;
    }

    .form {
        padding: 18px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.wide {
        grid-column: auto;
    }

    .form-actions {
        flex-direction: column;
    }

    .form-actions .button {
        width: 100%;
    }

    th,
    td {
        padding: 13px 12px;
    }

    .stock-summary {
        grid-template-columns: 1fr;
    }

    .article-detail-page .stock-total,
    .article-detail-page .stock-minimum {
        padding: 20px;
    }

    .article-detail-page .stock-total strong,
    .article-detail-page .stock-minimum strong {
        font-size: 28px;
    }

    .article-detail-page .stock-form {
        padding: 18px;
    }

    .article-detail-page .stock-form > .form-grid {
        grid-template-columns: 1fr;
    }

    .issue-card {
        padding: 18px;
    }

    .issue-form {
        align-items: stretch;
        flex-direction: column;
    }

    .issue-form .button {
        width: 100%;
    }

    .article-qr-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .article-qr-code {
        width: 160px;
        height: 160px;
    }

    .today-summary {
        padding: 18px;
    }
}
