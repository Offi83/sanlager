# false: technische Fehler nur allgemein anzeigen, Details stehen im
# PHP-Fehlerprotokoll. Nur zum Entwickeln auf true setzen – dann zeigt der
# Browser Fehlerdetails (z. B. SQL), das gehört nicht auf den Server.
APP_DEBUG=false
DB_DATABASE=database/database.sqlite
APP_TIMEZONE=Europe/Berlin

# ---------------------------------------------------------------------
# Wochenbericht per E-Mail (bin/weekly-report.php, per Cron)
# Details: docs/12-wochenbericht.md
# ---------------------------------------------------------------------

# SMTP-Zugang, Sonderzeichen im Passwort URL-kodieren (z. B. @ als %40)
MAILER_DSN=smtp://benutzer:passwort@smtp.example.org:587?require_tls=true

# Absender und Empfänger (mehrere durch Komma getrennt)
REPORT_FROM="SanLager <lager@example.org>"
REPORT_RECIPIENTS=materialwart@example.org

# Vorlaufzeit für MHD-Warnungen in Tagen (Standard: 90) – gilt für den
# Wochenbericht und für „MHD bald erreicht“ in der App
REPORT_EXPIRY_DAYS=90

# Adresse der Weboberfläche für Links in der E-Mail (optional)
APP_URL=https://lager.example.org

# ---------------------------------------------------------------------
# Datensicherung (bin/backup.php, per Cron) – Details: docs/13-datensicherung.md
# ---------------------------------------------------------------------

# Zielordner, möglichst auf einem anderen Datenträger (USB-Stick, NAS).
# Relativ zum Projektordner oder absolut. Standard: backups/
BACKUP_DIR=backups

# Wie viele Tage Sicherungen aufbewahrt werden (Standard: 30)
BACKUP_KEEP_DAYS=30
